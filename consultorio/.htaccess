# Plataforma do consultório: fora do Google enquanto está em desenvolvimento e sempre revalidada
# (assim, cada publicação chega aos usuários sem esperar cache antigo).
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Documentação interna: não é servida.
<FilesMatch "\.(md|sql|log)$">
  Require all denied
</FilesMatch>
