# Repassa o cabeçalho Authorization pro PHP (necessário em alguns ambientes Apache+PHP-FPM).
CGIPassAuth On

RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Qualquer caminho dentro de /api/ (exceto arquivo ou pasta real) cai no roteador único.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Nunca serve o config.php por engano, mesmo que alguém peça a URL direta.
<Files "config.php">
  Require all denied
</Files>

# Bibliotecas internas do blog e arquivos de semente: só o roteador (index.php) deve carregá-los.
<FilesMatch "^(blog_(lib|routes)|seed_[a-z_]+)\.php$">
  Require all denied
</FilesMatch>

# Ajustes de PHP da pasta (limites de upload): não precisam ser lidos pela web.
<Files ".user.ini">
  Require all denied
</Files>
